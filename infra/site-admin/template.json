{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Khalid Shams private control room and consented first-party telemetry",
  "Parameters": {
    "PublicOrigin": {
      "Type": "String",
      "Default": "https://khalidshams.com",
      "AllowedValues": [
        "https://khalidshams.com"
      ]
    },
    "OwnerEmail": {
      "Type": "String",
      "AllowedPattern": "[^@ ]+@[^@ ]+\\.[^@ ]+"
    },
    "AuthDomainPrefix": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9-]{8,50}"
    }
  },
  "Resources": {
    "Events": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "OnDemandThroughput": {
          "MaxReadRequestUnits": 40,
          "MaxWriteRequestUnits": 40
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        }
      }
    },
    "Inquiries": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "OnDemandThroughput": {
          "MaxReadRequestUnits": 40,
          "MaxWriteRequestUnits": 40
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        }
      }
    },
    "Audit": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "OnDemandThroughput": {
          "MaxReadRequestUnits": 40,
          "MaxWriteRequestUnits": 40
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        }
      }
    },
    "Sessions": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "OnDemandThroughput": {
          "MaxReadRequestUnits": 40,
          "MaxWriteRequestUnits": 40
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        }
      }
    },
    "OriginSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true
        },
        "Description": "CloudFront origin validation and short-lived keyed abuse counters"
      }
    },
    "OwnerPool": {
      "Type": "AWS::Cognito::UserPool",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "UsernameAttributes": [
          "email"
        ],
        "AutoVerifiedAttributes": [
          "email"
        ],
        "MfaConfiguration": "ON",
        "EnabledMfas": [
          "SOFTWARE_TOKEN_MFA"
        ],
        "DeletionProtection": "ACTIVE",
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 14,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true,
            "TemporaryPasswordValidityDays": 2
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        }
      }
    },
    "OwnerGroup": {
      "Type": "AWS::Cognito::UserPoolGroup",
      "Properties": {
        "GroupName": "owner",
        "UserPoolId": {
          "Ref": "OwnerPool"
        },
        "Description": "Explicitly provisioned site owners"
      }
    },
    "OwnerUser": {
      "Type": "AWS::Cognito::UserPoolUser",
      "Properties": {
        "UserPoolId": {
          "Ref": "OwnerPool"
        },
        "Username": {
          "Ref": "OwnerEmail"
        },
        "DesiredDeliveryMediums": [
          "EMAIL"
        ],
        "UserAttributes": [
          {
            "Name": "email",
            "Value": {
              "Ref": "OwnerEmail"
            }
          },
          {
            "Name": "email_verified",
            "Value": "true"
          }
        ]
      }
    },
    "OwnerMembership": {
      "Type": "AWS::Cognito::UserPoolUserToGroupAttachment",
      "DependsOn": [
        "OwnerGroup",
        "OwnerUser"
      ],
      "Properties": {
        "UserPoolId": {
          "Ref": "OwnerPool"
        },
        "GroupName": "owner",
        "Username": {
          "Ref": "OwnerEmail"
        }
      }
    },
    "ResourceServer": {
      "Type": "AWS::Cognito::UserPoolResourceServer",
      "Properties": {
        "UserPoolId": {
          "Ref": "OwnerPool"
        },
        "Identifier": "site-admin",
        "Name": "Site owner API",
        "Scopes": [
          {
            "ScopeName": "owner",
            "ScopeDescription": "Access the private site control room"
          }
        ]
      }
    },
    "OwnerClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "DependsOn": "ResourceServer",
      "Properties": {
        "UserPoolId": {
          "Ref": "OwnerPool"
        },
        "GenerateSecret": false,
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthScopes": [
          "openid",
          "email",
          "site-admin/owner",
          "aws.cognito.signin.user.admin"
        ],
        "SupportedIdentityProviders": [
          "COGNITO"
        ],
        "CallbackURLs": [
          {
            "Fn::Sub": "${PublicOrigin}/api/auth/callback"
          }
        ],
        "LogoutURLs": [
          {
            "Fn::Sub": "${PublicOrigin}/login/"
          }
        ],
        "AccessTokenValidity": 15,
        "IdTokenValidity": 15,
        "RefreshTokenValidity": 1,
        "TokenValidityUnits": {
          "AccessToken": "minutes",
          "IdToken": "minutes",
          "RefreshToken": "days"
        },
        "EnableTokenRevocation": true,
        "PreventUserExistenceErrors": "ENABLED"
      }
    },
    "OwnerDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "Domain": {
          "Ref": "AuthDomainPrefix"
        },
        "UserPoolId": {
          "Ref": "OwnerPool"
        }
      }
    },
    "Api": {
      "Type": "AWS::Serverless::Api",
      "Properties": {
        "StageName": "prod",
        "EndpointConfiguration": {
          "Type": "REGIONAL"
        },
        "CacheClusterEnabled": false,
        "MethodSettings": [
          {
            "ResourcePath": "/*",
            "HttpMethod": "*",
            "ThrottlingBurstLimit": 20,
            "ThrottlingRateLimit": 10,
            "DataTraceEnabled": false,
            "LoggingLevel": "OFF",
            "MetricsEnabled": true
          }
        ]
      }
    },
    "App": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "CodeUri": "../../services/site-admin/",
        "Handler": "app.handler",
        "Runtime": "python3.12",
        "Architectures": [
          "arm64"
        ],
        "Timeout": 29,
        "MemorySize": 512,
        "ReservedConcurrentExecutions": 5,
        "Environment": {
          "Variables": {
            "PUBLIC_ORIGIN": {
              "Ref": "PublicOrigin"
            },
            "USER_POOL_ID": {
              "Ref": "OwnerPool"
            },
            "CLIENT_ID": {
              "Ref": "OwnerClient"
            },
            "AUTH_DOMAIN": {
              "Fn::Sub": "https://${AuthDomainPrefix}.auth.${AWS::Region}.amazoncognito.com"
            },
            "RATE_SECRET": {
              "Ref": "OriginSecret"
            },
            "EVENTS_TABLE": {
              "Ref": "Events"
            },
            "INQUIRIES_TABLE": {
              "Ref": "Inquiries"
            },
            "AUDIT_TABLE": {
              "Ref": "Audit"
            },
            "SESSIONS_TABLE": {
              "Ref": "Sessions"
            }
          }
        },
        "Policies": [
          {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "dynamodb:GetItem",
                  "dynamodb:PutItem",
                  "dynamodb:UpdateItem",
                  "dynamodb:DeleteItem",
                  "dynamodb:Query",
                  "dynamodb:Scan",
                  "dynamodb:BatchWriteItem"
                ],
                "Resource": [
                  {
                    "Fn::GetAtt": [
                      "Events",
                      "Arn"
                    ]
                  },
                  {
                    "Fn::GetAtt": [
                      "Inquiries",
                      "Arn"
                    ]
                  },
                  {
                    "Fn::GetAtt": [
                      "Audit",
                      "Arn"
                    ]
                  },
                  {
                    "Fn::GetAtt": [
                      "Sessions",
                      "Arn"
                    ]
                  }
                ]
              },
              {
                "Effect": "Allow",
                "Action": [
                  "cognito-idp:AdminGetUser",
                  "cognito-idp:AdminListGroupsForUser"
                ],
                "Resource": {
                  "Fn::GetAtt": [
                    "OwnerPool",
                    "Arn"
                  ]
                }
              },
              {
                "Effect": "Allow",
                "Action": [
                  "secretsmanager:GetSecretValue"
                ],
                "Resource": {
                  "Ref": "OriginSecret"
                }
              }
            ]
          }
        ],
        "Events": {
          "Proxy": {
            "Type": "Api",
            "Properties": {
              "RestApiId": {
                "Ref": "Api"
              },
              "Path": "/api/{proxy+}",
              "Method": "ANY"
            }
          },
          "Retention": {
            "Type": "Schedule",
            "Properties": {
              "Schedule": "rate(15 minutes)",
              "Enabled": true
            }
          }
        }
      }
    },
    "AppLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${App}"
        },
        "RetentionInDays": 14
      }
    },
    "NoCache": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-no-cache"
          },
          "MinTTL": 0,
          "MaxTTL": 0,
          "DefaultTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": false,
            "EnableAcceptEncodingBrotli": false,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    },
    "ApiOriginPolicy": {
      "Type": "AWS::CloudFront::OriginRequestPolicy",
      "Properties": {
        "OriginRequestPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-api-origin"
          },
          "CookiesConfig": {
            "CookieBehavior": "all"
          },
          "QueryStringsConfig": {
            "QueryStringBehavior": "all"
          },
          "HeadersConfig": {
            "HeaderBehavior": "whitelist",
            "Headers": [
              "Origin",
              "Content-Type",
              "X-Csrf-Token",
              "User-Agent",
              "CloudFront-Viewer-Address"
            ]
          }
        }
      }
    }
  },
  "Outputs": {
    "ApiHost": {
      "Value": {
        "Fn::Sub": "${Api}.execute-api.${AWS::Region}.amazonaws.com"
      }
    },
    "PoolId": {
      "Value": {
        "Ref": "OwnerPool"
      }
    },
    "ClientId": {
      "Value": {
        "Ref": "OwnerClient"
      }
    },
    "OriginSecretArn": {
      "Value": {
        "Ref": "OriginSecret"
      }
    },
    "NoCachePolicyId": {
      "Value": {
        "Ref": "NoCache"
      }
    },
    "OriginRequestPolicyId": {
      "Value": {
        "Ref": "ApiOriginPolicy"
      }
    }
  }
}
